+
+bool PS2Runtime::registerOverflowFunction(uint32_t address, RecompiledFunction func)
+{
+    if ((address & 3u) != 0u)
+    {
+        std::cerr << "[function-table] cannot register unaligned guest PC 0x" << std::hex << address
+                  << std::dec << std::endl;
+        return false;
+    }
+
+    std::unique_lock<std::shared_mutex> lock(g_overflowFunctionsMutex);
+    if (func == nullptr)
+    {
+        g_overflowFunctions.erase(address);
+        return true;
+    }
+
+    g_overflowFunctions[address] = func;
+    return true;
+}
+
+PS2Runtime::RecompiledFunction PS2Runtime::lookupOverflowFunction(uint32_t address)
+{
+    std::shared_lock<std::shared_mutex> lock(g_overflowFunctionsMutex);
+    const auto it = g_overflowFunctions.find(address);
+    return it != g_overflowFunctions.end() ? it->second : nullptr;
+}
+
+bool PS2Runtime::hasOverflowFunction(uint32_t address)
+{
+    return lookupOverflowFunction(address) != nullptr;
+}
+
+void PS2Runtime::clearOverflowFunctions()
+{
+    std::unique_lock<std::shared_mutex> lock(g_overflowFunctionsMutex);
+    g_overflowFunctions.clear();
+}
+
+void PS2Runtime::bindErxImport(uint32_t slotAddress, uint32_t targetAddress)
+{
+    std::lock_guard<std::mutex> lock(g_erxImportMutex);
+    g_erxImportTargets[slotAddress & ~3u] = targetAddress;
+}
+
+void PS2Runtime::unbindErxImport(uint32_t slotAddress)
+{
+    std::lock_guard<std::mutex> lock(g_erxImportMutex);
+    g_erxImportTargets.erase(slotAddress & ~3u);
+}
+
+bool PS2Runtime::isErxImportBound(uint32_t slotAddress)
+{
+    std::lock_guard<std::mutex> lock(g_erxImportMutex);
+    return g_erxImportTargets.find(slotAddress & ~3u) != g_erxImportTargets.end();
+}
+
+void PS2Runtime::clearErxImportBindings()
+{
+    std::lock_guard<std::mutex> lock(g_erxImportMutex);
+    g_erxImportTargets.clear();
+    g_erxImportReportedUnbound.clear();
+}
