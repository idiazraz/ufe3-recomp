+    // PS2X_IDLE_DUMP=<ms>: periodically print guest thread state (default every 2000 ms).
+    template <typename SnapshotFn>
+    void dumpIdleSnapshot(const PS2Runtime &runtime, const uint8_t *rdram, SnapshotFn &&getSnapshot)
+    {
+        static const char *env = std::getenv("PS2X_IDLE_DUMP");
+        if (env == nullptr)
+        {
+            return;
+        }
+        static const long intervalMs = std::atol(env) > 1 ? std::atol(env) : 2000;
+        static auto last = std::chrono::steady_clock::time_point{};
+        const auto now = std::chrono::steady_clock::now();
+        if (now - last < std::chrono::milliseconds(intervalMs))
+        {
+            return;
+        }
+        last = now;
+        const EeKernelSnapshot snap = getSnapshot();
+        std::fprintf(stderr, "[idle-dump] running=%d eeCycle=%llu threads=%zu\n",
+                     snap.runningThreadId, static_cast<unsigned long long>(snap.eeCycle), snap.threads.size());
+        for (const EeThreadSnapshot &t : snap.threads)
+        {
+            std::fprintf(stderr, "[idle-dump]  tid=%d status=%u wait=%u waitId=%d pc=%08x ra=%08x sp=%08x entry=%08x prio=%d inv=%u\n",
+                         t.id, static_cast<unsigned>(t.status), static_cast<unsigned>(t.waitReason), t.waitId,
+                         t.pc, t.ra, t.sp, t.entry, t.currentPriority, t.invocationDepth);
+        }
+        // PS2X_SOUNDMAN_PEEK=1: UFE3 SOUNDMAN.IRX (base 0x4cf00) job slot table at base+0x486d8, {job*, active}.
+        static const bool peekSoundman = std::getenv("PS2X_SOUNDMAN_PEEK") != nullptr;
+        if (peekSoundman)
+        {
+            constexpr uint32_t kSlotTable = 0x4cf00u + 0x486d8u;
+            for (uint32_t slot = 0; slot < 32u; ++slot)
+            {
+                uint32_t entry[2]{};
+                if (!runtime.debugReadIopMemory(kSlotTable + slot * 8u, entry, sizeof(entry)) || (entry[0] == 0u && entry[1] == 0u))
+                {
+                    continue;
+                }
+                uint32_t job[16]{};
+                (void)runtime.debugReadIopMemory(entry[0] & 0x1fffffu, job, sizeof(job));
+                std::fprintf(stderr, "[idle-dump]  sm slot=%u job=%08x active=%u flags=%08x state=%u w3c=%08x | %08x %08x %08x %08x\n",
+                             slot, entry[0], entry[1], job[0], job[11], job[15], job[1], job[2], job[3], job[4]);
+            }
+        }
+        // PS2X_EE_PEEK=addr[*][,addr...]: dump 16 words of EE RAM; a trailing '*' dereferences the word first.
+        static const char *eePeek = std::getenv("PS2X_EE_PEEK");
+        if (eePeek != nullptr && rdram != nullptr)
+        {
+            const char *cursor = eePeek;
+            while (*cursor != '\0')
+            {
+                char *end = nullptr;
+                uint32_t addr = static_cast<uint32_t>(std::strtoul(cursor, &end, 0));
+                if (end == cursor)
+                    break;
+                const bool deref = (*end == '*');
+                if (deref)
+                {
+                    addr = *reinterpret_cast<const uint32_t *>(rdram + (addr & 0x1FFFFFCu));
+                    ++end;
+                }
+                std::fprintf(stderr, "[idle-dump]  ee %08x:", addr);
+                for (uint32_t i = 0; i < 16u; ++i)
+                    std::fprintf(stderr, " %08x", *reinterpret_cast<const uint32_t *>(rdram + ((addr + i * 4u) & 0x1FFFFFCu)));
+                std::fprintf(stderr, "\n");
+                cursor = (*end == ',') ? end + 1 : end;
+            }
+        }
+        for (const EeSemaphoreSnapshot &sema : snap.semaphores)
+        {
+            std::fprintf(stderr, "[idle-dump]  sema=%d count=%d max=%d waiters=%u\n",
+                         sema.id, sema.count, sema.maxCount, sema.waiters);
+        }
+        for (const EeEventFlagSnapshot &ef : snap.eventFlags)
+        {
+            std::fprintf(stderr, "[idle-dump]  evf=%d bits=%08x waiters=%u\n", ef.id, ef.bits, ef.waiters);
+        }
+    }
