+    void PS2Recompiler::collectErxImportStubSlots()
+    {
+        m_erxImportStubSlots.clear();
+
+        // ERX/liberx import stub slot pattern (generic, no .erx.stub parsing needed):
+        //     break 0x0,0x1            (raw word 0x0000004D)
+        //     addiu $zero,$zero,N      (raw word 0x24000000 | N)
+        // N is the import's index in the named library's export table. Dispatch is
+        // keyed by the slot address: generated code calls
+        // runtime->callErxImport(rdram, ctx, slotAddress), which consults the
+        // binding table filled through PS2Runtime::bindErxImport().
+        constexpr uint32_t kBreakZeroOneWord = 0x0000004Du;
+        constexpr uint32_t kAddiuZeroZeroMask = 0xFFFF0000u;
+        constexpr uint32_t kAddiuZeroZeroWord = 0x24000000u;
+
+        for (const Section &section : m_sections)
+        {
+            if (!section.isCode || section.data == nullptr || section.size < 2u * sizeof(uint32_t))
+            {
+                continue;
+            }
+
+            for (uint32_t offset = 0; offset + 2u * sizeof(uint32_t) <= section.size; offset += sizeof(uint32_t))
+            {
+                uint32_t first = 0u;
+                uint32_t second = 0u;
+                std::memcpy(&first, section.data + offset, sizeof(first));
+                std::memcpy(&second, section.data + offset + sizeof(uint32_t), sizeof(second));
+                if (first == kBreakZeroOneWord && (second & kAddiuZeroZeroMask) == kAddiuZeroZeroWord)
+                {
+                    m_erxImportStubSlots.insert(section.address + offset);
+                }
+            }
+        }
+
+        if (m_erxImportStubSlots.empty())
+        {
+            return;
+        }
+
+        // On hardware every slot is an independent callable entry (callers JAL
+        // straight into it and the slot tail-dispatches to the bound export), so
+        // make sure no slot ends up hidden inside another function's body: slots
+        // outside every discovered function become their own 8-byte function, and
+        // functions containing slots are split at the slot starts.
+        for (uint32_t slot : m_erxImportStubSlots)
+        {
+            bool covered = false;
+            for (const Function &function : m_functions)
+            {
+                if (slot >= function.start && slot < function.end)
+                {
+                    covered = true;
+                    break;
+                }
+            }
+
+            if (!covered)
+            {
+                Function stubFunction;
+                char buffer[32]{};
+                std::snprintf(buffer, sizeof(buffer), "sub_%08X", slot);
+                stubFunction.name = buffer;
+                stubFunction.start = slot;
+                stubFunction.end = slot + 8u;
+                stubFunction.isRecompiled = false;
+                stubFunction.isStub = false;
+                stubFunction.isSkipped = false;
+                m_functions.push_back(stubFunction);
+            }
+        }
+
+        std::vector<Function> resliced;
+        resliced.reserve(m_functions.size() + m_erxImportStubSlots.size());
+        for (const Function &function : m_functions)
+        {
+            std::vector<uint32_t> splitPoints;
+            for (uint32_t slot : m_erxImportStubSlots)
+            {
+                if (slot > function.start && slot < function.end)
+                {
+                    splitPoints.push_back(slot);
+                }
+            }
+
+            if (splitPoints.empty())
+            {
+                resliced.push_back(function);
+                continue;
+            }
+
+            std::sort(splitPoints.begin(), splitPoints.end());
+            splitPoints.erase(std::unique(splitPoints.begin(), splitPoints.end()), splitPoints.end());
+
+            uint32_t pieceStart = function.start;
+            for (uint32_t splitPoint : splitPoints)
+            {
+                Function piece = function;
+                piece.start = pieceStart;
+                piece.end = splitPoint;
+                if (pieceStart != function.start)
+                {
+                    char buffer[32]{};
+                    std::snprintf(buffer, sizeof(buffer), "sub_%08X", pieceStart);
+                    piece.name = buffer;
+                    piece.isStub = false;
+                    piece.isSkipped = false;
+                }
+                resliced.push_back(piece);
+                pieceStart = splitPoint;
+            }
+
+            Function tail = function;
+            tail.start = pieceStart;
+            tail.end = function.end;
+            if (pieceStart != function.start)
+            {
+                char buffer[32]{};
+                std::snprintf(buffer, sizeof(buffer), "sub_%08X", pieceStart);
+                tail.name = buffer;
+                tail.isStub = false;
+                tail.isSkipped = false;
+            }
+            resliced.push_back(tail);
+        }
+
+        std::sort(resliced.begin(), resliced.end(),
+                  [](const Function &a, const Function &b)
+                  { return a.start < b.start; });
+        m_functions = std::move(resliced);
+
+        std::ostringstream msg;
+        msg << "found " << std::dec << m_erxImportStubSlots.size() << " ERX import stub slots";
+        m_reporter.progress(msg.str());
+    }
+
