+#include "MiniTest.h"
+#include "ps2_runtime.h"
+#include "ps2_runtime_macros.h"
+
+#include <cstdint>
+#include <sstream>
+#include <string>
+
+namespace
+{
+    uint32_t g_erxTargetCalls = 0u;
+    uint32_t g_erxTargetEntryPc = 0u;
+
+    void erxTargetHandler(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        (void)rdram;
+        (void)runtime;
+        ++g_erxTargetCalls;
+        g_erxTargetEntryPc = ctx->pc;
+        // jr $ra
+        ctx->pc = getRegU32(ctx, 31);
+    }
+
+    void erxSilentTargetHandler(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        (void)rdram;
+        (void)ctx;
+        (void)runtime;
+        ++g_erxTargetCalls;
+    }
+
+    size_t countOccurrences(const std::string &haystack, const std::string &needle)
+    {
+        size_t count = 0;
+        size_t pos = 0;
+        while ((pos = haystack.find(needle, pos)) != std::string::npos)
+        {
+            ++count;
+            pos += needle.size();
+        }
+        return count;
+    }
+}
+
+void register_ps2_erx_tests()
+{
+    MiniTest::Case("ERX overflow function registry", [](TestCase &tc)
+    {
+        tc.Run("overflow registration and lookup work outside the dense table", [](TestCase &t)
+        {
+            PS2Runtime::clearOverflowFunctions();
+
+            // Inside the test dense table range (its slots are empty here) the
+            // registry must still be consulted after the dense lookup misses.
+            const uint32_t kInsideTable = 0x01C00018u;
+            // Fully outside every dense table: the pure sparse path (real ERX
+            // module code sits at 0x01C00000+ in the game, above its dense table).
+            const uint32_t kOutsideTable = 0x10000000u;
+            const uint32_t kReplaceAddr = 0x10000010u;
+
+            PS2Runtime runtime;
+            t.IsFalse(runtime.hasFunction(kInsideTable), "registry must start empty");
+            t.IsFalse(runtime.hasFunction(kOutsideTable), "registry must start empty");
+
+            t.IsTrue(PS2Runtime::registerOverflowFunction(kInsideTable, &erxTargetHandler),
+                      "registerOverflowFunction should accept aligned addresses");
+            t.IsTrue(PS2Runtime::registerOverflowFunction(kOutsideTable, &erxTargetHandler),
+                      "registerOverflowFunction should accept aligned addresses");
+            // registerFunction/replaceFunction transparently fall back to the
+            // overflow registry for guest PCs outside the dense table.
+            t.IsTrue(runtime.registerFunction(kReplaceAddr, &erxSilentTargetHandler),
+                      "registerFunction should accept out-of-table addresses");
+
+            t.IsTrue(runtime.hasFunction(kInsideTable), "hasFunction must consult the overflow registry");
+            t.IsTrue(runtime.hasFunction(kOutsideTable), "hasFunction must consult the overflow registry");
+            t.IsTrue(runtime.hasFunction(kReplaceAddr), "registerFunction fallback must be discoverable");
+            t.IsTrue(PS2Runtime::hasOverflowFunction(kOutsideTable), "hasOverflowFunction should find the entry");
+
+            t.IsTrue(runtime.lookupFunction(kInsideTable) == &erxTargetHandler,
+                      "lookupFunction must resolve overflow entries inside the table range");
+            t.IsTrue(runtime.lookupFunction(kOutsideTable) == &erxTargetHandler,
+                      "lookupFunction must resolve overflow entries outside the table range");
+            t.IsTrue(PS2Runtime::lookupOverflowFunction(kReplaceAddr) == &erxSilentTargetHandler,
+                      "lookupOverflowFunction must resolve registered entries");
+            t.IsFalse(PS2Runtime::registerOverflowFunction(kOutsideTable + 1u, &erxTargetHandler),
+                       "unaligned registration must be rejected");
+
+            PS2Runtime::clearOverflowFunctions();
+            t.IsFalse(runtime.hasFunction(kOutsideTable), "clearOverflowFunctions must empty the registry");
+        });
+    });
+
+    MiniTest::Case("ERX import stub dispatch", [](TestCase &tc)
+    {
+        tc.Run("callErxImport dispatches bound slots to their target", [](TestCase &t)
+        {
+            PS2Runtime::clearOverflowFunctions();
+            PS2Runtime::clearErxImportBindings();
+
+            PS2Runtime runtime;
+            const uint32_t kSlot = 0x0035B408u;   // main-ELF stub slot shape
+            const uint32_t kTarget = 0x10000000u; // module export shape
+            const uint32_t kReturnPc = 0x00212348u;
+
+            g_erxTargetCalls = 0u;
+            g_erxTargetEntryPc = 0u;
+            PS2Runtime::registerOverflowFunction(kTarget, &erxTargetHandler);
+            PS2Runtime::bindErxImport(kSlot, kTarget);
+
+            t.IsTrue(PS2Runtime::isErxImportBound(kSlot), "bound slot must report bound");
+
+            R5900Context ctx{};
+            SET_GPR_U32(&ctx, 31, kReturnPc);
+            ctx.pc = kSlot;
+
+            std::stringstream log;
+            std::streambuf *oldBuf = std::cerr.rdbuf(log.rdbuf());
+            const bool dispatched = runtime.callErxImport(nullptr, &ctx, kSlot);
+            std::cerr.rdbuf(oldBuf);
+
+            t.IsTrue(dispatched, "bound slot must dispatch");
+            t.Equals(g_erxTargetCalls, 1u, "target must run exactly once");
+            t.Equals(g_erxTargetEntryPc, kTarget, "target must be entered at its guest address");
+            t.Equals(ctx.pc, kReturnPc, "target's jr $ra must return to the caller's link address");
+            t.Equals(countOccurrences(log.str(), "unbound"), size_t(0), "bound slot must not report");
+        });
+
+        tc.Run("callErxImport reports unbound slots once and traps", [](TestCase &t)
+        {
+            PS2Runtime::clearOverflowFunctions();
+            PS2Runtime::clearErxImportBindings();
+
+            PS2Runtime runtime;
+            const uint32_t kSlot = 0x0035B410u;
+
+            t.IsFalse(PS2Runtime::isErxImportBound(kSlot), "slot must start unbound");
+
+            std::stringstream log;
+            std::streambuf *oldBuf = std::cerr.rdbuf(log.rdbuf());
+            R5900Context ctx{};
+            SET_GPR_U32(&ctx, 31, 0x00212348u);
+            ctx.pc = kSlot;
+            const bool first = runtime.callErxImport(nullptr, &ctx, kSlot);
+            const bool second = runtime.callErxImport(nullptr, &ctx, kSlot);
+            std::cerr.rdbuf(oldBuf);
+
+            t.IsFalse(first, "unbound slot must not dispatch");
+            t.IsFalse(second, "unbound slot must not dispatch");
+            t.Equals(countOccurrences(log.str(), "unbound import stub"), size_t(1),
+                     "unbound slot must be reported exactly once");
+
+            // The unlinked stub is a `break 0x0,0x1` on hardware: the fallback
+            // must take the same break trap as the original instruction.
+            t.IsTrue((ctx.cop0_cause & 0x7Cu) == ((uint32_t)EXCEPTION_BREAKPOINT << 2),
+                     "unbound slot must raise the breakpoint exception");
+
+            PS2Runtime::bindErxImport(kSlot, 0x10000000u);
+            t.IsTrue(PS2Runtime::isErxImportBound(kSlot), "bindErxImport must register the slot");
+            PS2Runtime::unbindErxImport(kSlot);
+            t.IsFalse(PS2Runtime::isErxImportBound(kSlot), "unbindErxImport must remove the slot");
+        });
+
+        tc.Run("callErxImport returns to $ra when the target does not touch the PC", [](TestCase &t)
+        {
+            PS2Runtime::clearOverflowFunctions();
+            PS2Runtime::clearErxImportBindings();
+
+            PS2Runtime runtime;
+            const uint32_t kSlot = 0x0035B418u;
+            const uint32_t kTarget = 0x10000010u;
+            const uint32_t kReturnPc = 0x00212348u;
+
+            g_erxTargetCalls = 0u;
+            PS2Runtime::registerOverflowFunction(kTarget, &erxSilentTargetHandler);
+            PS2Runtime::bindErxImport(kSlot, kTarget);
+
+            R5900Context ctx{};
+            SET_GPR_U32(&ctx, 31, kReturnPc);
+            ctx.pc = kSlot;
+
+            t.IsTrue(runtime.callErxImport(nullptr, &ctx, kSlot), "bound slot must dispatch");
+            t.Equals(g_erxTargetCalls, 1u, "target must run exactly once");
+            t.Equals(ctx.pc, kReturnPc, "stub slot is a tail-call trampoline: fall back to the link address");
+        });
+    });
+}
