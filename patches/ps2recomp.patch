+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+// Cheap per-function hit counters for recompiled code (PS2X_FUNC_HISTOGRAM build option).
+namespace ps2_hist
+{
+struct Counter;
+inline std::atomic<Counter *> &head()
+{
+    static std::atomic<Counter *> h{nullptr};
+    return h;
+}
+struct Counter
+{
+    const char *name;
+    std::atomic<uint64_t> hits{0};
+    Counter *next = nullptr;
+    explicit Counter(const char *n) : name(n)
+    {
+        next = head().load(std::memory_order_relaxed);
+        while (!head().compare_exchange_weak(next, this, std::memory_order_release, std::memory_order_relaxed))
+        {
+        }
+    }
+};
+// Writes "hits name" for every function hit since the last call, then resets the counters.
+inline void dumpAndReset(std::FILE *out)
+{
+    for (Counter *c = head().load(std::memory_order_acquire); c != nullptr; c = c->next)
+    {
+        const uint64_t n = c->hits.exchange(0, std::memory_order_relaxed);
+        if (n != 0u)
+            std::fprintf(out, "%llu %s\n", static_cast<unsigned long long>(n), c->name);
+    }
+}
+}
+#define PS_LOG_ENTRY(name)                                \
+    static ps2_hist::Counter _ps2_hist_counter_{name}; \
