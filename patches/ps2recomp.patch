+void PSPadBackend::pollMain()
+{
+    // Main/render thread only: GLFW joystick functions are not thread-safe.
+    static bool s_loggedJoysticks = false;
+    int gamepad = -1;
+    for (int jid = 0; jid <= GLFW_JOYSTICK_LAST; ++jid)
+    {
+        if (glfwJoystickPresent(jid) != GLFW_TRUE)
+            continue;
+        const bool mapped = glfwJoystickIsGamepad(jid) == GLFW_TRUE;
+        if (!s_loggedJoysticks)
+        {
+            const char *name = glfwGetJoystickName(jid);
+            std::fprintf(stderr, "[pad] joystick %d: %s (%s)%s\n", jid, name ? name : "?",
+                         mapped ? "mapped gamepad" : "not a mapped gamepad",
+                         mapped && gamepad < 0 ? " [candidate]" : "");
+        }
+        if (mapped && gamepad < 0)
+            gamepad = jid;
+    }
+    if (!s_loggedJoysticks)
+    {
+        if (gamepad >= 0)
+            std::fprintf(stderr, "[pad] using joystick %d as gamepad\n", gamepad);
+        else
+            std::fprintf(stderr, "[pad] no mapped gamepad found\n");
+        std::fprintf(stderr, "[pad] keyboard input enabled\n");
+        s_loggedJoysticks = true;
+    }
+
+    GLFWgamepadstate state{};
+    const bool ok = gamepad >= 0 && glfwGetGamepadState(gamepad, &state) == GLFW_TRUE;
+    std::lock_guard<std::mutex> lock(m_snapshotMutex);
+    m_hasGamepad = ok;
+    if (ok)
+    {
+        std::memcpy(m_buttons, state.buttons, sizeof(m_buttons));
+        std::memcpy(m_axes, state.axes, sizeof(m_axes));
+    }
+}
